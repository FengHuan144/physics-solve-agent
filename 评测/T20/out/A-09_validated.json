        "caption_source": "none",
        "is_required": false,
        "file": null,
        "file_sha256": null
      }
    ],
    "subquestions": [
      {
        "no": "(1)",
        "text": "绳子被拉断时小球的速度大小，及绳子所受的最大拉力大小。",
        "score": 6
      },
      {
        "no": "(2)",
        "text": "小球做平抛运动时抛出点到落地点的水平距离。",
