{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://physics-agent.local/schema/answer.schema.json",
  "title": "步骤单元解析 answer",
  "description": "一条解析 = 一次生成尝试的产物。五个环节（S1-S5）共用；四层质检按步定位；老师按步驳回。draft-07，所有对象 additionalProperties:false。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meta",
    "question",
    "situation",
    "outline",
    "steps",
    "grading",
    "validation",
    "triage",
    "review"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.2.1"
      ],
      "description": "Schema 版本。1.0 为原始版（仅 A-06 一样例）；1.1 为 T08b 扩到 7 类题型后的版本；1.2 为 T08d 四缺陷清算版（equation 可空 + criterion 专放判据 + figures[].provides + input_sha256 + segment_id/boundary_reference + given.source）；1.2.1 为 T08e 图指纹补洞版（figures[].file + figures[].file_sha256，条件必填）。写盘用 1.2.1；1.0/1.1/1.2 仅为向后兼容读入旧样例保留，一律不许删。"
    },
    "meta": {
      "$ref": "#/definitions/meta"
    },
    "question": {
      "$ref": "#/definitions/question"
    },
    "situation": {
      "$ref": "#/definitions/situation"
    },
    "outline": {
      "type": "array",
      "minItems": 1,
      "description": "步骤大纲。支撑「先出大纲再逐步展开」：expanded=false 表示尚未展开，允许部分完成。",
      "items": {
        "$ref": "#/definitions/outline_item"
      }
    },
    "steps": {
      "type": "array",
      "description": "已展开的步骤单元。step_no 必须 ⊆ outline，且严格递增。允许只覆盖大纲的前 k 步（部分完成）。",
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "grading": {
      "$ref": "#/definitions/grading"
    },
    "validation": {
      "$ref": "#/definitions/validation"
    },
    "triage": {
      "$ref": "#/definitions/triage"
    },
    "review": {
      "$ref": "#/definitions/review"
    }
  },
  "allOf": [
    {
      "description": "1.2.1 的图指纹两字段是条件必填：只在 schema_version=1.2.1 时进 required。1.0/1.1/1.2 的档案没有这两个键，若硬写进 figures 的 required，「旧档案读不进」——这与 enum 只加不删是同一条兼容性承诺。",
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.2.1"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "question": {
            "properties": {
              "figures": {
                "items": {
                  "required": [
                    "file",
                    "file_sha256"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_id",
        "question_id",
        "group",
        "source",
        "question_no",
        "full_score",
        "mode",
        "model",
        "prompt_version",
        "temperature",
        "generated_at",
        "latency_ms",
        "tokens",
        "stem_source"
      ],
      "properties": {
        "answer_id": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}-\\d{2}(-R\\d{1,2})?$",
          "description": "本次解析的标识。同一题多次生成时用 -R2/-R3 区分，与 question_id 不同。"
        },
        "question_id": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}-\\d{2}$",
          "description": "金标题号，与采分点表 point_id 的前缀一致（A-06）。"
        },
        "group": {
          "enum": [
            "A",
            "B",
            "Z"
          ],
          "description": "A 压轴 / B 作业 / Z 题库外新题（2026-11-26 T40：Z 组无金标、无采分点，只出解析与自洽检查）。指标必须分组报，故进 Schema。"
        },
        "source": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "question_no": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "题号。题库外新题没有卷面题号，允许 null（2026-11-26 T40）。"
        },
        "full_score": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "卷面分。必须等于 grading.score_total 与各小问分值之和。"
        },
        "mode": {
          "enum": [
            "gold",
            "free",
            "rewrite",
            "zero"
          ],
          "description": "gold 下 steps[].point_id 必填；free 下由 S5 回填，允许暂空；rewrite 只改失败步，steps 可为子集且 rewrite_rounds>=1；zero = 题库外新题，无金标、无采分点，grading 允许为空（2026-11-26 T40）。"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "in",
            "out"
          ],
          "properties": {
            "in": {
              "type": "integer",
              "minimum": 0
            },
            "out": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "stem_source": {
          "enum": [
            "original",
            "summary",
            "reconstructed",
            "user_paste",
            "model_ocr"
          ],
          "description": "题干来源。summary = 40-80 字要点，不足以拆点；reconstructed = 由采分点反推复原，须标注；user_paste = 用户粘贴的题库外原文（2026-11-26 T40）；model_ocr = 用户只给了题图，题干由模型读图逐字转写（页面须标注，不得冒充原文）。"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stem_text",
        "stem_sha256",
        "figures",
        "subquestions"
      ],
      "properties": {
        "stem_text": {
          "type": "string",
          "minLength": 10
        },
        "stem_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "stem_text 的 sha256（UTF-8 原文字节）。扰动实验靠它确认题干真的变了。"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "1.2 新增。解题输入指纹 = sha256(stem_text + 分隔串 + 规范化后的全部 figures[].provides)。规范化：按 (fig_no, symbol, value, unit, read_from, text) 升序排序，每项以竖线拼成一行、行间以换行相连；value 为数值时按 float 的 17 位有效数字格式化。stem_sha256 保留不动，两指纹并存：只改图读数时 stem_sha256 不变而本值必变。"
        },
        "figures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fig_no",
              "caption",
              "caption_source",
              "is_required"
            ],
            "properties": {
              "fig_no": {
                "type": "integer",
                "minimum": 1
              },
              "caption": {
                "type": "string",
                "minLength": 2
              },
              "caption_source": {
                "enum": [
                  "vlm",
                  "human",
                  "summary",
                  "none"
                ],
                "description": "none 表示该图无 caption，则依赖图题必须降级为人工。"
              },
              "is_required": {
                "type": "boolean",
                "description": "对应采分点表「依赖图」列：题干必须配图才能唯一确定情境。"
              },
              "file": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "pattern": "^(?![A-Za-z]:)(?![/\\\\])",
                "description": "1.2.1 新增（缺陷 ①）。图文件相对工作区根的路径，正斜杠书写，如 原始资料/题图/B-20_图乙.png。没有图就写 null，不许留空串；不许写绝对路径（pattern 已拦盘符与起始的 / 或 \\），换机器才不失效。file 为 null 时必须与 file_sha256 同步（R16），非 null 时文件必须存在且哈希逐字相等（R17）。"
              },
              "file_sha256": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9a-f]{64}$",
                "description": "1.2.1 新增（缺陷 ①）。图文件字节的 sha256（小写十六进制 64 位）。必须由脚本读磁盘现算，不许手抄、不许填常量。它锁的是「这道题的图是哪一张」，与 provides 锁的「读数说了什么」互补：只改 provides 会改 input_sha256，只换图会改本字段，两者都不动才算输入未变。"
              },
              "provides": {
                "type": "array",
                "description": "1.2 新增（缺陷 ①）。本图提供的读数/条件 —— 图即数据源时，这些值只在图上，题干文字没有。读数属于输入的一部分，写在这里才会进 input_sha256；given 里标 source=figure 的项必须能在某个 provides 里找到同符号项。",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "symbol",
                    "value",
                    "unit",
                    "read_from",
                    "text"
                  ],
                  "properties": {
                    "symbol": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9]*$",
                      "description": "T09 symbol_id，与 situation.given[].symbol 同一套。"
                    },
                    "value": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "读数值。全符号题（读数本身是 1.2v₀ 这类符号量）填 null，把符号表达写进 text —— 此时与 given.value=null 一致，校验只查符号存在不查数值。"
                    },
                    "unit": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9/^*.·-]+$",
                      "description": "无量纲写 1。"
                    },
                    "read_from": {
                      "type": "string",
                      "minLength": 2,
                      "description": "图上位置，如「图乙第一段斜率」「图乙 F>4 N 段截距」。必须能让人按这句话把数再读一遍。"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 4,
                      "description": "给老师看的读数句，如「由图乙第一段斜率读出 k₁＝0.5 kg⁻¹」。不许写「见图」「同上」。"
                    }
                  }
                }
              }
            }
          }
        },
        "subquestions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "no",
              "text",
              "score"
            ],
            "properties": {
              "no": {
                "type": "string",
                "pattern": "^\\(\\d+\\)$"
              },
              "text": {
                "type": "string",
                "minLength": 2
              },
              "score": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    },
    "situation": {
      "type": "object",
      "additionalProperties": false,
      "description": "S1 情境解析的四要素。缺任一要素，S2 无从建模。",
      "required": [
        "objects",
        "given",
        "process_segments",
        "targets",
        "assumptions"
      ],
      "properties": {
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "mass_symbol",
              "note"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^obj\\d+$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "mass_symbol": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]*$",
                "description": "T09 symbol_id，不许写 m₁ 这类 Unicode 下标。"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "given": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "symbol",
              "value",
              "unit",
              "text"
            ],
            "properties": {
              "symbol": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]*$"
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "非数值条件（如 M=m）填 null，在 text 里写清。"
              },
              "unit": {
                "type": "string",
                "pattern": "^[A-Za-z0-9/^*.·-]+$",
                "description": "无量纲写 1。"
              },
              "text": {
                "type": "string",
                "minLength": 2
              },
              "source": {
                "enum": [
                  "stem",
                  "figure"
                ],
                "description": "1.2 新增（缺陷 ①）。这项输入从哪来：stem＝题干文字给的（缺省即此值）；figure＝从图上读出来的，必须与某个 figures[].provides 同符号且数值一致。"
              }
            }
          }
        },
        "process_segments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "no",
              "name",
              "start",
              "end"
            ],
            "properties": {
              "no": {
                "type": "integer",
                "minimum": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "string",
                "minLength": 1
              },
              "end": {
                "type": "string",
                "minLength": 1
              },
              "segment_id": {
                "type": "string",
                "pattern": "^SEG-\\d{2}$",
                "description": "1.2 新增（缺陷 ③）。过程分段的稳定标识，供 steps[].segment_id 引用。缺省时步骤只能靠 no 对位，L4 无法做「过程分段 ↔ 步」的映射。"
              },
              "boundary_reference": {
                "type": "string",
                "minLength": 4,
                "description": "1.2 新增（缺陷 ③）。本段起止（尤其边界条件）的参照物，如「以碰前瞬间为起点」「以弹簧原长为零势能点」「以桌面为 h=0」。没有参照物的边界，L4 判不了一致性。"
              }
            }
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "no",
              "quantity",
              "text"
            ],
            "properties": {
              "no": {
                "type": "string",
                "pattern": "^\\(\\d+\\)$"
              },
              "quantity": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9]*$"
              },
              "text": {
                "type": "string",
                "minLength": 2
              }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "outline_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_no",
        "title",
        "depends_on",
        "expanded"
      ],
      "properties": {
        "step_no": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "description": "前序 step_no。空数组表示无前置。"
        },
        "expanded": {
          "type": "boolean",
          "description": "false = 只出了大纲、还没展开成 step。部分完成时靠它读数。"
        },
        "point_hint": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{1,3}-\\d{2}-S\\d{2}$",
          "description": "S1 阶段对采分点的猜测，可空。最终以 steps[].point_id 为准。"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "step_id",
        "step_no",
        "title",
        "point_id",
        "kind",
        "statement",
        "value",
        "law_ids",
        "checks",
        "confidence",
        "status"
      ],
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^[A-Z]{1,3}-\\d{2}(-R\\d{1,2})?-S\\d{2}$",
          "description": "本次解析的第几步。free 模式下必须与 point_id 拉开（如 A-06-R2-S01），否则 S5 对齐无从判断。"
        },
        "step_no": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "point_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{1,3}-\\d{2}-S\\d{2}$",
          "description": "金标采分点。gold 必填且须在采分点表存在；free 由 S5 回填；null 表示尚未对齐。"
        },
        "kind": {
          "enum": [
            "judgment",
            "equation",
            "value",
            "discussion",
            "critical"
          ],
          "description": "对应采分点五类：①judgment 状态判断 ②equation 原始方程 ③value 过程量与结果 ④discussion 结果规范 ⑤critical 临界与范围。"
        },
        "statement": {
          "type": "string",
          "minLength": 5,
          "description": "这一步在说什么。给老师看的一句话，不是解题过程。"
        },
        "equation": {
          "description": "1.2 起可空（缺陷 ④）。判断步（judgment）与临界步（critical）没有学生要写的方程，填 null 并把判据放 criterion；方程步/求值步（equation/value）必须非 null 且不得带 criterion。discussion 不强制：可只有 equation，也可只有 criterion。",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/definitions/equation"
            }
          ]
        },
        "criterion": {
          "$ref": "#/definitions/criterion"
        },
        "segment_id": {
          "type": "string",
          "pattern": "^SEG-\\d{2}$",
          "description": "1.2 新增（缺陷 ③）。本步属于哪个过程分段，指向 situation.process_segments[].segment_id。可选：跨段步骤（如整体列式）可不填。"
        },
        "value": {
          "$ref": "#/definitions/value"
        },
        "law_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^L-\\d{2}$"
          },
          "description": "T10 的 law_id（L-01…L-12）。equation / critical 步不得为空；judgment 步可空。"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/check"
          }
        },
        "confidence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "仅用于同批排序，禁止作为通过阈值（方案 D4）。"
        },
        "status": {
          "enum": [
            "draft",
            "checked",
            "failed",
            "rejected"
          ]
        }
      }
    },
    "equation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latex",
        "sympy",
        "symbols",
        "parse_status"
      ],
      "properties": {
        "latex": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "description": "受限 LaTeX 子集（T09 R8）：frac sqrt cdot times sin cos tan le ge approx ^ _ { } 与 mu theta alpha omega Delta pi，加字母数字。禁 text/mathrm/left/right/begin，禁中文。"
        },
        "sympy": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200,
          "pattern": "^[^=]+$",
          "description": "归一化可解析串，写成「左边减右边」=0 的形式（f - mu*m*g）。不许出现等号；分数写 Rational(1,2) 或 S(1)/2，不许裸 1/2；不许小数。"
        },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9]*$"
          },
          "description": "T09 symbol_id 引用，不许自由文本。符号必须与 sympy 里实际出现的名字一致。"
        },
        "parse_status": {
          "enum": [
            "ok",
            "degraded",
            "failed"
          ],
          "description": "解析失败是状态不是判错。degraded 单独统计比例，>20% 停用 L2；不得计入 fail。"
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "description": "1.2 新增（缺陷 ④ 方案乙）。判断步的判据专放处 —— 它不是学生要解的方程，而是「凭什么这样判」的表达式 + 期望值。四项必填，不许空壳：expr 空、text 写「同上」都不许。",
      "required": [
        "expr",
        "expected",
        "comparator",
        "text"
      ],
      "properties": {
        "expr": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "判据表达式，sympy 语法，如 Fnet、(M + m)*mu*g、v2**2/(2*a1)。不许含等号。"
        },
        "expected": {
          "type": [
            "number",
            "string",
            "null"
          ],
          "description": "期望值。数值写 number；符号量写 sympy 串（如 \"2*v0\"、\"s2\"）；纯定性判断写 null。"
        },
        "comparator": {
          "enum": [
            "eq",
            "ne",
            "gt",
            "ge",
            "lt",
            "le",
            "qualitative"
          ],
          "description": "expr 与 expected 的比较方式。qualitative＝定性判据（expected 应为 null），只要求 text 能独立读懂。"
        },
        "text": {
          "type": "string",
          "minLength": 6,
          "description": "判据的自然语言原文，必须能独立读懂：写「弹力只能指向圆心，故 N＝3mg 与 mg 同向」，不写「同上」「见式」「如前」。"
        }
      }
    },
    "value": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "symbol",
        "unit"
      ],
      "description": "本步得出的量。只做判断或只列式的步填 null。",
      "properties": {
        "symbol": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*$"
        },
        "number": {
          "type": [
            "number",
            "null"
          ],
          "description": "十进制近似值，供 L1 回代。精确值同时写 exact。"
        },
        "exact": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 40,
          "description": "精确值字符串，如 5/9、3*sqrt(2*g*R)/2。不许写 0.56 这种近似。",
          "pattern": "^[0-9A-Za-z+\\-*/().^_ ]+$"
        },
        "unit": {
          "type": "string",
          "pattern": "^[A-Za-z0-9/^*.·-]+$"
        },
        "direction": {
          "enum": [
            "+x",
            "-x",
            "+y",
            "-y",
            "逆时针",
            "顺时针",
            null
          ],
          "description": "只允许这几个值，自由文本方向无法比对。"
        },
        "sig_figs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 6
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "status",
        "detail",
        "error_code"
      ],
      "properties": {
        "layer": {
          "enum": [
            "L1",
            "L2",
            "L3",
            "L4"
          ],
          "description": "checks 只记自动四层。L5 建模与依据仅人工、L6 表达仅辅助，不产生步级自动检查。"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "na",
            "skipped"
          ],
          "description": "skipped = 因 degraded 停用该层，不是 fail。"
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "error_code": {
          "$ref": "#/definitions/error_code"
        }
      }
    },
    "error_code": {
      "enum": [
        "E-01",
        "E-02",
        "E-03",
        "E-04",
        "E-05",
        "E-06",
        "E-07",
        "E-08",
        "E-09",
        "E-10",
        "E-11",
        "E-12",
        "E-13",
        "E-14",
        "E-15",
        "E-16",
        "E-20",
        "E-21",
        "E-22",
        "E-23",
        "E-24",
        null
      ],
      "description": "取值域 = 错误码枚举 21 条（E-01~E-16、E-20~E-24），不许自创。"
    },
    "grading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point_hits",
        "missing_points",
        "extra_steps",
        "score_awarded",
        "score_total",
        "weighted_rate"
      ],
      "properties": {
        "point_hits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "point_id",
              "step_id",
              "score_awarded",
              "score_possible",
              "hit",
              "note"
            ],
            "properties": {
              "point_id": {
                "type": "string",
                "pattern": "^[A-Z]{1,3}-\\d{2}-S\\d{2}$"
              },
              "step_id": {
                "type": "string",
                "pattern": "^[A-Z]{1,3}-\\d{2}(-R\\d{1,2})?-S\\d{2}$"
              },
              "score_awarded": {
                "type": "number",
                "minimum": 0
              },
              "score_possible": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "必须等于采分点表该点的分值。"
              },
              "hit": {
                "type": "boolean",
                "description": "hit=false 但进 point_hits，表示部分分。"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "missing_points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "point_id",
              "reason"
            ],
            "properties": {
              "point_id": {
                "type": "string",
                "pattern": "^[A-Z]{1,3}-\\d{2}-S\\d{2}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "extra_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{1,3}-\\d{2}(-R\\d{1,2})?-S\\d{2}$"
          },
          "description": "有步骤但不对应任何采分点。多写不扣分，但要在界面标出来。"
        },
        "score_awarded": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "得分数。zero 模式（题库外新题、无采分点）未判分，取 null（2026-11-26 T40）。"
        },
        "score_total": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "description": "必须等于 meta.full_score。zero 模式下无采分点可计，取 null。"
        },
        "weighted_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "主指标：score_awarded / score_total。校验器会重算，不接受手填。zero 模式取 null。"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layers",
        "failures",
        "zero_point_hit",
        "rewrite_rounds"
      ],
      "properties": {
        "layers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "L1",
            "L2",
            "L3",
            "L4"
          ],
          "description": "整题层状态。L1 计算(sympy 回代) L2 量纲(pint) L3 边界(扰动/极限) L4 条件一致 L5 建模与依据(仅人工) L6 表达(仅辅助)。",
          "properties": {
            "L1": {
              "$ref": "#/definitions/layer_status"
            },
            "L2": {
              "$ref": "#/definitions/layer_status"
            },
            "L3": {
              "$ref": "#/definitions/layer_status"
            },
            "L4": {
              "$ref": "#/definitions/layer_status"
            },
            "L5": {
              "$ref": "#/definitions/layer_status"
            },
            "L6": {
              "$ref": "#/definitions/layer_status"
            }
          }
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_id",
              "layer",
              "error_code",
              "detail"
            ],
            "properties": {
              "step_id": {
                "type": "string",
                "pattern": "^[A-Z]{1,3}-\\d{2}(-R\\d{1,2})?-S\\d{2}$"
              },
              "layer": {
                "enum": [
                  "L1",
                  "L2",
                  "L3",
                  "L4",
                  "L5",
                  "L6"
                ],
                "description": "失败归到哪一层。L5 的失败只能来自人工标注。"
              },
              "error_code": {
                "$ref": "#/definitions/error_code"
              },
              "detail": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "zero_point_hit": {
          "type": "boolean",
          "description": "是否触碰归零点（E-01 基数误取 / E-20 图像读数错）。true 则 triage.level 必须 red。"
        },
        "rewrite_rounds": {
          "type": "integer",
          "minimum": 0,
          "description": "本题已重写轮数。三档路由靠「重写 2 轮仍失败」区分红档。"
        }
      }
    },
    "layer_status": {
      "enum": [
        "pass",
        "fail",
        "na",
        "skipped"
      ]
    },
    "triage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "signals",
        "reason"
      ],
      "properties": {
        "level": {
          "enum": [
            "green",
            "yellow",
            "red"
          ],
          "description": "green 自动入库+5% 抽检；yellow 老师快扫；red 全审。归零点命中必须 red。"
        },
        "signals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hard_check",
            "question_type_prior",
            "self_rank",
            "rework_rate"
          ],
          "properties": {
            "hard_check": {
              "enum": [
                "pass",
                "partial",
                "fail"
              ]
            },
            "question_type_prior": {
              "enum": [
                "high",
                "mid",
                "low"
              ],
              "description": "题型先验风险：多过程/含临界=high。"
            },
            "self_rank": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1,
              "description": "同批内排序位次（分位数），不是模型自评分绝对值。gold 稿可填 null。"
            },
            "rework_rate": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "reason": {
          "type": "string",
          "minLength": 4
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "rejected_steps",
        "reason_codes",
        "diffs",
        "added_steps",
        "reordered"
      ],
      "properties": {
        "verdict": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "edited"
          ]
        },
        "rejected_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{1,3}-\\d{2}(-R\\d{1,2})?-S\\d{2}$"
          }
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/error_code"
          },
          "description": "驳回原因码，取值域 = 21 条错误码，不许自创「建模错/依据错」这类新词。"
        },
        "diffs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_id",
              "before",
              "after"
            ],
            "properties": {
              "step_id": {
                "type": "string",
                "pattern": "^[A-Z]{1,3}-\\d{2}(-R\\d{1,2})?-S\\d{2}$"
              },
              "before": {
                "type": "string",
                "minLength": 1
              },
              "after": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "description": "D6：老师的修改必须落成结构化前后文本，自由文本批注沉淀不成规则。"
        },
        "added_steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step_id",
              "title",
              "statement"
            ],
            "properties": {
              "step_id": {
                "type": "string",
                "pattern": "^[A-Z]{1,3}-\\d{2}(-R\\d{1,2})?-S\\d{2}$"
              },
              "title": {
                "type": "string",
                "minLength": 2
              },
              "statement": {
                "type": "string",
                "minLength": 5
              }
            }
          }
        },
        "reordered": {
          "type": "boolean"
        }
      }
    }
  }
}
